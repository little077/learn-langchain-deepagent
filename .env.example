# Model config (required): key + base_url + model
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Model params. There is no fallback in the code: an empty value means the
# parameter is not sent at all, and the provider default applies instead.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# Some providers reject tool_choice=required/object while thinking mode is on
# (Error code 400). Set to false to use ToolStrategy structured output.
# Turning thinking off also removes reasoning_content, i.e. the [thinking] line
# printed by main.py.
LLM_ENABLE_THINKING=true

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-python

# Web search proxy (optional)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
